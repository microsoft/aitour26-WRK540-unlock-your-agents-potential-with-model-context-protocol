# =============================================================================
# WRK540 - Unlock Your Agent's Potential with MCP
# Copy this file to .env and fill in your values
# =============================================================================

# Azure AI Foundry
PROJECT_ENDPOINT="<your_project_endpoint>"
AZURE_OPENAI_ENDPOINT="<your_azure_openai_endpoint>"

# Model Deployments
GPT_MODEL_DEPLOYMENT_NAME="gpt-4o"
EMBEDDING_MODEL_DEPLOYMENT_NAME="text-embedding-3-small"

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING="<your_application_insights_connection_string>"
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED="true"

# DevTunnel (for MCP server connectivity)
DEV_TUNNEL_URL="<your_dev_tunnel_url>"

# Row Level Security - Store Role
# Use "00000000-0000-0000-0000-000000000000" for head office (see all stores)
RLS_USER_ID="00000000-0000-0000-0000-000000000000"